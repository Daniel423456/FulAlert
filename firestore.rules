rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if true;
    }

    // ALERTS COLLECTION
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // BROADCASTS COLLECTION
    match /broadcasts/{broadcastId} {
      allow read, write: if true;
    }
  }
}
